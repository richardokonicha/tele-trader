{
  "title": "SB Admin",
  "name": "startbootstrap-sb-admin",
  "version": "6.0.0",
  "scripts": {
    "build": "node init && npm run clean && npm run build:pug && npm run build:scss && npm run build:scripts && npm run build:assets",
    "build:assets": "node init && node scripts/build-assets.js",
    "build:pug": "node init && node scripts/build-pug.js",
    "build:scripts": "node init && node scripts/build-scripts.js",
    "build:scss": "node init && node scripts/build-scss.js",
    "clean": "node scripts/clean.js",
    "start": "node init && npm run build && node scripts/start.js",
    "start:debug": "node init && npm run build && node scripts/start-debug.js"
  },
  "description": "A free admin dashboard template based on Bootstrap 4, created by Start Bootstrap.",
  "keywords": [
    "css",
    "sass",
    "html",
    "responsive",
    "theme",
    "template",
    "admin",
    "app",
    "dashboard"
  ],
  "homepage": "https://startbootstrap.com/templates/sb-admin",
  "bugs": {
    "url": "https://github.com/BlackrockDigital/startbootstrap-sb-admin/issues",
    "email": "feedback@startbootstrap.com"
  },
  "license": "MIT",
  "author": "Start Bootstrap",
  "contributors": [
    "David Miller (http://davidmiller.io/)"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/BlackrockDigital/startbootstrap-sb-admin.git"
  },
  "dependencies": {
    "bootstrap": "4.4.1"
  },
  "devDependencies": {
    "autoprefixer": "9.7.4",
    "browser-sync": "2.26.7",
    "chokidar": "3.3.1",
    "concurrently": "5.0.2",
    "postcss": "7.0.26",
    "prettier": "1.19.1",
    "pug": "2.0.4",
    "sass": "1.25.0",
    "shelljs": "0.8.3"
  }
}
